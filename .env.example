# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Gmail account used to send email sign-in codes.
# Use a Google App Password (requires 2-Step Verification), not the Gmail password.
GMAIL_ADDRESS="your-club-account@gmail.com"
GMAIL_APP_PASSWORD="YOUR_16_CHARACTER_APP_PASSWORD"

# Optional: send new booking, cafe order, and shop order alerts to one private Telegram chat.
# Create a replacement bot token with BotFather and set the recipient chat ID here.
# Alerts include customer/member names and transaction details, but not phone, email, or address.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# DATABASE_PATH: SQLite database file location (defaults to data/champions_club.db)
DATABASE_PATH="data/champions_club.db"

# JWT_SECRET: Signing key for session tokens (auto-generated random secret in dev if unset)
JWT_SECRET="0b797d22909bdf6e2a4c65a36190436b55fc0a9ef6e58a6ecf29d22c3870a3a3"
